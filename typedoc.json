{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "../obSync/backend/main.ts",
    "../obSync/plugin/obSync/src/main.ts"
  ],
  "out": "../../../Dev/projects/obSyncDocs/",
  "compilerOptions": {
    "skipLibCheck": true,
    "strictNullChecks": false,
    "allowImportingTsExtensions": true,
    "target": "es2024",
    "allowSyntheticDefaultImports": true,
    "module": "nodenext"
  },
  "externalSymbolLinkMappings": {
    "typescript": { "setInterval": "#" },
    "obsidian": { "addIcon": "#", "Workspace.updateOptions": "#" }
  }
}
