{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./backend/", "./plugin/obSync/src/"],
  "entryPointStrategy": "expand",
  "plugin": ["@clean-jsdoc-theme/typedoc"],
  "tsconfig": "./tsconfig.typedoc.json",
  "outputs": [
    {
      "name": "clean-jsdoc-theme",
      "path": "../../../Dev/projects/obSyncDocs/docs"
    }
  ],
  "cleanJsdocTheme": {
    "siteName": "obSync",
    "docs": "docs",
    "basePath": "/obsyncDocs"
  },
  "readme": "./README.md",
  "excludePrivateClassFields": false,
  "excludePrivate": false,
  "externalSymbolLinkMappings": {
    "typescript": {
      "setInterval": "#"
    },
    "obsidian": {
      "addIcon": "#",
      "Workspace.updateOptions": "#"
    },
    "@types/node": {
      "\"node:sqlite\".SQLTagStore": "#"
    }
  }
}
