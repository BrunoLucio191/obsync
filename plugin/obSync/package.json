		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	},
	"dependencies": {
		"@codemirror/state": "^6.5.0",
		"i18next": "^26.4.0",
